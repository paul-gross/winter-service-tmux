# Declarative manifest for winter-service-tmux (TOML format).
# Copy this to workspace:/ai/project/setup-tmux.toml and customize.
#
# This file is the live configuration for the Python orchestrator. It describes
# every service in a structured, machine-readable format consumed at runtime by
# the service_orchestrator package. The Python reader (service_manifest.reader)
# loads ai/project/setup-tmux.toml, merges ai/project/setup-tmux.local.toml on
# top (if present), and returns a validated ServiceManifest. Structural errors
# (missing keys, malformed TOML) raise ManifestError. Semantic violations
# (duplicate targets, unresolvable ${VAR}) are returned as a list by the validator.
#
# Validate with:
#   PYTHONPATH=src python3 -m service_manifest.cli validate <workspace-or-worktree-dir>
#
# For machine-specific overrides that shouldn't be committed, add a sibling
# setup-tmux.local.toml — the reader merges it on top using the same overlay
# semantics (scalars replace; [[service]] and [[status.url]] merge keyed by
# name/label). Keep it gitignored.

# Session prefix — tmux sessions will be named <session_prefix>-<env>
# e.g., "mp" produces "mp-alpha", "mp-beta"
session_prefix = "mp"

# Environment file to load for ${VAR} interpolation and pane env sourcing
# (relative to the worktree root, optional).
env_file = ".winter.env"

# Optional bash layout hook — invoked by the orchestrator once per ./up,
# AFTER the tmux session is created. The hook creates the windows/panes;
# the orchestrator sends each service's command into its pane.
# Absent until you need a non-default layout; the doctor probe checks that this
# file exists and is executable when the field is set.
layout_hook = "ai/project/layout-hook.sh"

# ---------------------------------------------------------------------------
# Log capture — [logs] table (all keys optional; these are the defaults)
# ---------------------------------------------------------------------------
#
# Controls how per-service log files are written and rotated.  The capture
# writer (launched alongside each captured service) owns size-based rotation;
# the orchestrator's prune pass enforces retention.  Omit this table entirely
# to use all defaults.
#
# Keys:
#   rotate_size_bytes  — rotate the active .log file once it exceeds this size.
#                        Default: 10485760 (10 MiB).  Must be > 0.
#   max_rotations      — number of rotated segments to keep (.log.1 … .log.N).
#                        0 disables rotation (unbounded growth). Default: 5.
#   retention_seconds  — delete rotated segments older than this many seconds
#                        during a prune pass.  0 disables time-based pruning.
#                        Default: 604800 (7 days).

[logs]
rotate_size_bytes = 10485760  # 10 MiB
max_rotations = 5
retention_seconds = 604800    # 7 days

# ---------------------------------------------------------------------------
# Services — one [[service]] table per tmux pane
# ---------------------------------------------------------------------------
#
# Fields:
#   name     (required) — unique identifier; used in status output and ./restart
#   target   (required) — "<window>.<pane>", both zero-based integers
#   command  (optional, default "") — shell command to run in the pane;
#                                     "" means interactive pane (sits at prompt)
#   log      (optional, default "file") — log capture mode.  Allowed values:
#              "file"   — capture output to <env>/.winter/logs/<svc>.log via
#                         the writer (persisted, timestamped). Default.
#              "pane"   — read pane buffer via tmux capture-pane on demand; no
#                         file persistence, no timestamps; requires running
#                         session. Natural for interactive panes (shell) or
#                         services where TTY matters more than persistence.
#              "memory" — accepted but not yet implemented; logs emits nothing
#                         (future work).
#   scope    (optional, default "project") — "project" runs the service in the
#              per-env <session_prefix>-<env> session; "workspace" makes it a
#              workspace-scoped singleton (see the workspace section below).
#
# Targets must be unique across all services in the SAME scope. The layout hook
# is responsible for creating the windows/panes named here; the orchestrator
# sends the commands into them.

[[service]]
name = "backend"
target = "0.0"
command = "npm run start:dev"

[[service]]
name = "frontend"
target = "0.1"
command = "npm run dev"

[[service]]
# Interactive pane — command is empty; the pane gets the env sourced and a
# banner, then sits at a shell prompt. Mirrors `winter_service_cmd shell ""`
# in the bash config.  Set log = "pane" to read this pane via capture-pane
# (no file persistence, no timestamps, requires a running session).
name = "shell"
target = "1.0"
command = ""
log = "pane"

[[service]]
# Example of opting a commanded service to pane-mode capture.  The pane still
# runs the command; output is read live via capture-pane rather than a log file.
name = "watcher"
target = "1.1"
command = "npm run watch"
log = "pane"

# ---------------------------------------------------------------------------
# Status URLs — displayed in the ./status output header
# ---------------------------------------------------------------------------
#
# Fields:
#   label (required) — display name shown in ./status
#   url   (required) — template string; ${VAR} placeholders are resolved from
#                      env_file at validation time
#
# The validator reports unresolvable ${VAR} when an env file is present. When
# the env file is absent, ${VAR} resolution is skipped (warn-and-continue,
# matching the bash up script's behaviour).

[[status.url]]
label = "Backend"
url = "http://localhost:${BACKEND_PORT}"

[[status.url]]
label = "Frontend"
url = "http://localhost:${FRONTEND_PORT}"

# ---------------------------------------------------------------------------
# Workspace-scoped singleton services
# ---------------------------------------------------------------------------
#
# A [[service]] entry with scope = "workspace" runs in a SEPARATE tmux session
# named <session_prefix>-workspace (e.g. "mp-workspace"), created at the
# workspace root rather than a per-env worktree.  These are shared across all
# feature environments and are intended for long-running infrastructure that
# should not be duplicated per-env (e.g. a shared Docker daemon, a registry, a
# global build watcher).
#
# scope is the only field that distinguishes a workspace singleton from a
# per-env service:
#   scope = "project"   (DEFAULT, may be omitted) — per-env service, runs in
#                       the <session_prefix>-<env> session.
#   scope = "workspace" — workspace singleton, runs in <session_prefix>-workspace.
# All other fields (name/target/command/log) are identical to a project service.
#
# Name uniqueness is GLOBAL across both scopes — a project and a workspace
# service may not share a name.  Target uniqueness is per-scope: a workspace
# service at "0.0" and a project service at "0.0" do NOT conflict (different
# sessions / validated in their own namespace).
#
# Note: for workspace services that manage container lifetimes (e.g.
# `docker compose up`), down reaps the pane process tree, which terminates
# inline-launched containers (best-effort — containers started detached are
# not affected).
#
# workspace_layout_hook: optional bash script invoked once after the workspace
# session is created — same semantics as layout_hook but runs at the workspace
# root.  Relative to the workspace root.  It creates the workspace
# windows/panes; the orchestrator sends each service's command into its pane.

workspace_layout_hook = "ai/project/workspace-layout-hook.sh"

[[service]]
name = "docker"
target = "0.0"
command = "docker compose -f docker-compose.workspace.yml up"
scope = "workspace"

[[service]]
# Workspace pane-mode service — reads output via tmux capture-pane rather
# than a persisted log file.  Useful when the command has interactive output
# or TTY colouring that you want preserved.
name = "registry"
target = "0.1"
command = "docker run -p 5000:5000 registry:2"
log = "pane"
scope = "workspace"
