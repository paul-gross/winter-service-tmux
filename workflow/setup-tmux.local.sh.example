#!/usr/bin/env bash
# Machine-specific overrides for winter-service-tmux. OPTIONAL.
# Copy this to workspace:/ai/project/setup-tmux.local.sh and customize, then
# keep it gitignored — it's a per-developer / per-machine override that should
# never be committed.
#
# This file is sourced ON TOP of the committed setup-tmux.sh (overlay), so you
# only redeclare what you want to change. Everything you don't touch keeps the
# committed value. Order: setup-tmux.sh first, then this file.

# Override the session prefix — handy when the committed prefix collides with
# another project's tmux sessions on a shared machine.
SESSION_PREFIX="myprefix"

# Append a personal service to the ones the committed config declares. The names
# array already exists here (set by setup-tmux.sh), so extend it rather than
# reassigning from scratch, and declare the new service's command with another
# `winter_service_cmd` call — without it ./restart can't re-run the service (and
# your setup_tmux override can't launch it via winter_tmux_send_service). A second
# `winter_service_cmd` for an existing name overrides the committed one.
WINTER_TMUX_SERVICE_NAMES+=("1.0:debugger")
winter_service_cmd debugger "npm run debug"

# Redefine a function to change behavior locally. Because this file is sourced
# after setup-tmux.sh, the definition below wins. Wrap or replace as needed.
status_header() {
  local name="$1" dir="$2"
  echo "  [local overrides active]"
}
