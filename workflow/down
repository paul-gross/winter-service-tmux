#!/usr/bin/env bash
set -uo pipefail

INVOKE_DIR="$(cd "$(dirname "$0")" && pwd)"
WORKTREE_DIR="$INVOKE_DIR"
WORKTREE_NAME="$(basename "$WORKTREE_DIR")"
WORKSPACE_DIR="$(cd "$WORKTREE_DIR/.." && pwd)"

CONFIG="$WORKSPACE_DIR/ai/project/workflow.sh"
if [[ ! -f "$CONFIG" ]]; then
  echo "Error: No workflow.sh config found."
  exit 1
fi

# Tolerate a broken workflow.sh — this script is called by the destroy hook
# during `winter ws destroy`, and we must complete the PID sweep even if the
# user is mid-edit or the file has a syntax error. Disable `set -u` across the
# source so an unbound variable inside workflow.sh doesn't abort us before we
# get to the cleanup logic; restore -u immediately after.
SESSION_PREFIX=""
set +u
# shellcheck disable=SC1090
if ! source "$CONFIG" 2>/dev/null; then
  echo "warning: source $CONFIG failed; falling back to env-suffix session lookup" >&2
  SESSION_PREFIX=""
fi
set -u

if [[ -z "${SESSION_PREFIX:-}" ]]; then
  # workflow.sh is broken or doesn't define SESSION_PREFIX. We'll resolve the
  # session by env-suffix match below; until then, SESSION_PREFIX stays empty.
  :
fi

NAME=""
for arg in "$@"; do
  case "$arg" in
    local) NAME="local" ;;
    *)     NAME="$arg" ;;
  esac
done

if [[ -z "$NAME" ]]; then
  NAME="$WORKTREE_NAME"
  if [[ "$NAME" == "project" ]]; then
    echo "Usage: ./down [local|<worktree-name>]"
    echo "  or run from within a feature worktree"
    exit 1
  fi
fi

if [[ -n "$SESSION_PREFIX" ]]; then
  SESSION="${SESSION_PREFIX}-${NAME}"
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "No running session '$SESSION'"
    exit 0
  fi
else
  # workflow.sh failed to load — match any tmux session whose name ends with
  # -<name>. If none, exit 0 (the idempotency contract carried over from the
  # destroy hook's fallback path).
  SESSION="$(tmux ls -F '#{session_name}' 2>/dev/null | grep -E -- "-${NAME}\$" | head -1 || true)"
  if [[ -z "$SESSION" ]]; then
    echo "No running session for '$NAME' (workflow.sh failed to load and no env-suffix match)"
    exit 0
  fi
  echo "warning: using session '$SESSION' inferred from name suffix (workflow.sh failed to load)" >&2
fi

# Collect all descendant PIDs from every pane before killing anything.
ALL_PIDS=()
collect_descendants() {
  local children
  children=$(pgrep -P "$1" 2>/dev/null) || true
  for child in $children; do
    collect_descendants "$child"
  done
  [[ "$1" -ne $$ ]] && ALL_PIDS+=("$1")
}

while IFS= read -r pid; do
  [[ -n "$pid" ]] && collect_descendants "$pid"
done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_pid}' 2>/dev/null)

# SIGTERM everything, wait, then SIGKILL survivors. Guard the expansion because
# under `set -u` an empty array would raise "unbound variable" — happens when
# the session vanished between has-session and list-panes, or when there are
# no panes left.
if [[ ${#ALL_PIDS[@]} -gt 0 ]]; then
  kill -TERM "${ALL_PIDS[@]}" 2>/dev/null || true
  sleep 1
  kill -9 "${ALL_PIDS[@]}" 2>/dev/null || true
fi

# Kill the tmux session
tmux kill-session -t "$SESSION" 2>/dev/null || true
echo "Stopped services for '$NAME' (session: $SESSION)"
