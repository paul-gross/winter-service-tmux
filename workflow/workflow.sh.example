#!/usr/bin/env bash
# Project workflow configuration for winter workspace scripts.
# Copy this to workspace:/ai/project/workflow.sh and customize.

# Session prefix — tmux sessions will be named <prefix>-<worktree>
# e.g., "mp" produces "mp-alpha", "mp-beta"
SESSION_PREFIX="mp"

# Environment file to source (relative to worktree root, optional)
ENV_FILE=".winter.env"

# Service names — used by the status script to label each declared service.
# Entries can be either:
#   "<name>"                  — defaults to window 0; pane index = array position.
#                               Use this for simple single-window layouts.
#   "<window>.<pane>:<name>"  — explicit target. Required when services live in
#                               additional tmux windows.
WINTER_TMUX_SERVICE_NAMES=("0.0:backend" "0.1:frontend" "1.0:shell")

# setup_tmux — called by the up script to create tmux windows/panes and start services.
# Arguments: $1=SESSION, $2=WORKTREE_DIR, $3=NAME
#
# Renamed from `setup_panes` when multi-window support landed; the up script errors
# out clearly if only the legacy name is defined.
setup_tmux() {
  local session="$1" dir="$2" name="$3"
  # ENV_PATH is set by the up script when ENV_FILE is configured
  local env_cmd=""
  if [[ -n "${ENV_PATH:-}" ]]; then
    env_cmd="source '$ENV_PATH' && "
  fi

  # --- Window 0: application services (backend + frontend) ---

  # Pane 0.0: Backend
  tmux send-keys -t "$session:0.0" \
    "${env_cmd}echo '=== backend ===' && npm run start:dev" Enter

  # Split window 0 vertically (top/bottom)
  tmux split-window -v -t "$session:0.0" -c "$dir"

  # Pane 0.1: Frontend
  tmux send-keys -t "$session:0.1" \
    "${env_cmd}echo '=== frontend ===' && npm run dev" Enter

  # --- Window 1: utility shell ---

  # Create window 1 (single pane, 1.0)
  tmux new-window -t "$session" -c "$dir"
  tmux send-keys -t "$session:1.0" \
    "${env_cmd}echo '=== $name shell ==='" Enter

  # Land focus on window 0, backend pane
  tmux select-window -t "$session:0"
  tmux select-pane -t "$session:0.0"
}

# status_header — optional, called by the status script before pane status.
# Use it to display ports, URLs, or other project-specific info.
# Arguments: $1=NAME, $2=WORKTREE_DIR
status_header() {
  local name="$1" dir="$2"
  # Example: read ports from env file
  # if [[ -f "$dir/.env" ]]; then
  #   PORT=$(grep -oP 'PORT=\K\d+' "$dir/.env" 2>/dev/null || echo "?")
  #   echo "  http://localhost:$PORT"
  # fi
  :
}
