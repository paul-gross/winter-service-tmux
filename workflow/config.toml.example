# Declarative manifest for winter-service-tmux (TOML format).
# Copy this to workspace:/.winter/config/winter-service-tmux/config.toml and customize.
#
# This file is the live configuration for the Python orchestrator. It describes
# every service in a structured, machine-readable format consumed at runtime by
# the service_orchestrator package. The Python reader (service_manifest.reader)
# loads config.toml from the extension config dir, merges config.local.toml on
# top (if present), and returns a validated ServiceManifest. Structural errors
# (missing keys, malformed TOML) raise ManifestError. Semantic violations
# (duplicate targets, invalid mapping names, malformed ${VAR}) are returned as a list by the validator. References that
# depend on the dispatched scope are resolved during lifecycle preflight.
#
# The config dir is resolved via WINTER_EXT_CONFIG_DIR (set by winter on every
# orchestrator dispatch) or falls back to
# <workspace-root>/.winter/config/winter-service-tmux/ when that variable is unset.
#
# Validate with:
#   PYTHONPATH=src python3 -m service_manifest.cli validate <workspace-or-worktree-dir>
#
# For machine-specific overrides that shouldn't be committed, add a sibling
# config.local.toml in the same directory — the reader merges it on top using
# the same overlay semantics (scalars replace; [[service]] merges keyed by
# name; [service.env] keys merge additively). Keep it gitignored.

# Session-name prefix — DEPRECATED, not part of normal setup. Tmux sessions
# are named <prefix>-<env>, e.g. "mp" produces "mp-alpha", "mp-beta". The
# prefix is controlled entirely by winter via the WINTER_SERVICE_PREFIX
# environment variable it injects into the provider process on every
# dispatched action (up/down/status/restart/logs) — the single
# workspace-level prefix configured once for the whole workspace. Leave this
# key unset. It only exists as a manual escape
# hatch for the rare case this provider's tmux sessions must use a different
# prefix than the rest of the workspace (e.g. a collision on a shared
# machine); uncomment and hand-edit only if you specifically need that.
# session_prefix = "mp"

# Environment file for shell-expanded values used by service commands, mappings, and health probe targets
# (relative to the applicable scope root, optional: the feature-env root for project services, or the workspace root
# for workspace services). Omit when all required vars
# come from the canonical scope source — WINTER_ENV / WINTER_ENV_INDEX /
# WINTER_PORT_BASE and [env.workspace.vars] / [env.feature.vars] entries are
# supplied by the canonical scope source, so no env_file is needed for those. Set only
# when services need additional vars from a local file (e.g.
# machine-specific credentials) or a health probe target uses ${VAR}
# placeholders that reference file-sourced vars. Mappings use provider-side
# POSIX shell preflight, then resolve against the pane's single source evaluation
# so commands and mappings agree without putting file values in the tmux launch
# line. URL/CMD health paths evaluate the current scope and env_file sources
# when status runs. Services without mappings use plain sourcing.
# env_file = ".env.local"

# Optional bash layout hook — invoked once per ./up, AFTER the tmux session is
# created. The hook creates the windows/panes; the orchestrator sends each
# service's command into its pane. Absent until you need a non-default layout;
# the doctor probe checks that this file exists and is executable when the field
# is set.
# Value is a BARE FILENAME — resolved relative to this config dir (not the
# workspace root). Place layout-hook.sh alongside config.toml.
layout_hook = "layout-hook.sh"

# ---------------------------------------------------------------------------
# Log capture — [logs] table (all keys optional; these are the defaults)
# ---------------------------------------------------------------------------
#
# Controls how per-service log files are written and rotated.  The capture
# writer (launched alongside each captured service) owns size-based rotation;
# the orchestrator's prune pass enforces retention.  Omit this table entirely
# to use all defaults.
#
# Keys:
#   rotate_size_bytes  — rotate the active .log file once it exceeds this size.
#                        Default: 10485760 (10 MiB).  Must be > 0.
#   max_rotations      — number of rotated segments to keep (.log.1 … .log.N).
#                        0 disables rotation (unbounded growth). Default: 5.
#   retention_seconds  — delete rotated segments older than this many seconds
#                        during a prune pass.  0 disables time-based pruning.
#                        Default: 604800 (7 days).

[logs]
rotate_size_bytes = 10485760  # 10 MiB
max_rotations = 5
retention_seconds = 604800    # 7 days

# ---------------------------------------------------------------------------
# Services — one [[service]] table per tmux pane
# ---------------------------------------------------------------------------
#
# Fields:
#   name     (required) — unique identifier; used in status output and ./restart
#   target   (required) — "<window>.<pane>", both zero-based integers
#   cmd      (optional, default "") — shell command to run in the pane;
#                                     "" means interactive pane (sits at prompt)
#   log      (optional, default "file") — log capture mode.  Allowed values:
#              "file"   — capture output to <env>/.winter/logs/<svc>.log via
#                         the writer (persisted, timestamped). Default.
#              "pane"   — read pane buffer via tmux capture-pane on demand; no
#                         file persistence, no timestamps; requires running
#                         session. Natural for interactive panes (shell) or
#                         services where TTY matters more than persistence.
#              "memory" — accepted but not yet implemented; logs emits nothing
#                         (future work).
#   scope    (optional, default "project") — "project" runs the service in the
#              per-env <session_prefix>-<env> session; "workspace" makes it a
#              workspace-scoped singleton (see the workspace section below).
#   cwd      (optional) — working directory for this service, as a path
#              relative to the scope root: the feature-env root for
#              scope = "project", the workspace root for scope = "workspace".
#              A leading "./" is normalized away. Omit to cd to the scope root
#              (prior default behavior). Supersedes the cd-in-cmd idiom — write
#              cwd = "apps/backend" instead of cmd = "cd apps/backend && npm run dev".
#              An absolute path, or one that normalizes outside the scope root
#              (e.g. "../other"), is rejected by the validator.
#   [service.env] (optional) — additive environment variables exported in this
#              service's pane after the global env_file is sourced and before
#              the banner/command. Values are strings and may use ${NAME}
#              interpolation against inherited/core scope variables, global
#              env_file values, or earlier keys in this mapping. Direct
#              assignments in cmd may still override these exports. Mapping
#              values are not a secret store; use env_file for machine-local
#              credentials. A config.local.toml overlay replaces matching
#              committed keys, keeps omitted committed keys, and appends
#              local-only keys in local declaration order.
#   [service.health] (optional) — readiness probe reported in the status
#              document's health field and the env-root ./status output. It is
#              observability only: ./up does not wait for this probe.
#              type = "url" sends an HTTP GET to target and passes on 2xx/3xx.
#              type = "cmd" runs target as a shell command from the service's
#              launch directory (including cwd) and passes on exit 0.
#              type = "log" treats target as a regular expression and passes
#              when it matches (re.search) the service's captured output: the
#              tmux pane buffer for log = "pane" services, or a bounded tail of
#              the captured log file for log = "file" services (also accepted
#              for log = "memory", forward-compat only — memory mode is not
#              yet implemented, so there is no captured file to read).
#              Rejected by the validator on an empty-command (interactive)
#              service — there is no captured output to match — and target
#              must compile as a valid regex.
#              target may contain ${VAR} placeholders resolved from the
#              effective service environment (inherited/core vars, env_file,
#              then [service.env]); bare $VAR is not interpolated. EXCEPTION: type = "log" targets
#              are used VERBATIM — never interpolated — so regex syntax is
#              never mangled by substitution.
#              type = "uptime" treats target as a duration ("<N><unit>", unit
#              one of s/m/h/d — e.g. "30s", "5m", "1h", "2d"; identical to the
#              duration form `winter service logs --since` accepts) and passes
#              once the service's measured process has been alive at least
#              that long. The dumb, last-resort readiness signal for a service
#              with no HTTP endpoint, no cheap readiness command, and no
#              distinctive ready-line — so --wait has something to gate on.
#              Measures the tmux pane's direct child process (never the pane
#              shell); when the pane has several direct children, the
#              longest-running one is measured. Unhealthy while the pane has
#              no measurable child (an interactive/empty-command pane, or the
#              process exited). Because the clock is anchored on the child
#              process, `./restart <svc>` (which reaps children and relaunches)
#              naturally resets it. Rejected by the validator when target does
#              not parse as a valid duration.
#              Workspace-scoped services use the canonical `winter env workspace`
#              baseline, so their health targets and [service.env] mappings may
#              reference workspace-scope variables as well.
#              timeout is optional seconds; default is 5 (unused by type = "log"
#              and type = "uptime", neither of which has I/O to time out).
#   port     (optional) — declared port for this service, surfaced in the
#              ``PORTS`` column of ``winter service status``.  Two forms:
#              - Literal integer: ``port = 4070``
#              - Offset expression: ``port = "WINTER_PORT_BASE + 10"``
#                Resolved against the env's ``WINTER_PORT_BASE`` at status
#                time.  Services without a declared port render blank in
#                ``PORTS``.  Expression must match the pattern exactly; bare
#                integers are always treated as absolute port numbers.
#   [service.startup] (optional) — opt-in per-service startup retry policy.
#              When winter service up launches a service and its process exits
#              within a short settle window, up re-launches it up to retries
#              times, sleeping retry_delay seconds between attempts. Process-exit
#              detection only — not a health probe; composes with but is
#              independent of [service.health].
#              retries      optional int, default 0 — max re-launch attempts
#                           after the first failure; 0 means no retry (default,
#                           so the feature is opt-in per service).
#              retry_delay  optional number (seconds), default 2 — sleep between
#                           attempts.
#              Honored by `winter service up` — and by the env-root ./up, which
#              delegates to it. (./up does not forward the separate --wait flag.)
#              Requires a non-empty command: a retries > 0 policy on an
#              interactive (empty-command) pane never fires and the validator
#              rejects it.
#              After exhausting retries, `winter service up` exits non-zero and
#              names every service that failed to stay up; surviving services are
#              unaffected.
#   depends_on (optional) — list of service patterns this service must wait for
#              before `winter service up` launches it. Two forms:
#              - Bare pattern (e.g. "builder") — a same-scope reference: another
#                service declared in THIS SAME scope (project services depend on
#                other project services; workspace singletons depend on other
#                workspace singletons). Resolved at dispatch time against the
#                current scope (the feature env, or "workspace").
#              - Scope-qualified pattern (e.g. "workspace/db") — resolved
#                verbatim, letting a service depend on ANOTHER PROVIDER's
#                service (e.g. a docker-backed workspace singleton). Every
#                dependency — same-scope tmux service or cross-provider — is
#                polled through the identical `winter service status <pattern>
#                --json` seam, so this provider never special-cases which
#                provider owns the dependency.
#              A dependency is considered ready once its status reports
#              health = "healthy", or health = "unknown" (no declared probe)
#              and state = "running" (a liveness fallback for a probe-less
#              dependency); an "unhealthy"/"stopped" report keeps the dependent
#              waiting. Each dependency is polled for up to the caller's
#              effective `--wait --timeout` (winter core injects it as
#              `WINTER_SERVICE_TIMEOUT`), defaulting to 120 seconds when no
#              timeout is supplied (or the injected value is missing/invalid);
#              if it never becomes ready, `winter service up` exits non-zero
#              and names both the waiting service and the unmet dependency.
#              Rejected by the validator: a bare pattern that is a
#              self-reference, a bare pattern matching no service in the same
#              scope, or any depends_on cycle.
#
# Targets must be unique across all services in the SAME scope. The layout hook
# is responsible for creating the windows/panes named here; the orchestrator
# sends the commands into them.

[[service]]
name = "backend"
target = "0.0"
cmd = "npm run start:dev"
port = "WINTER_PORT_BASE + 10"  # resolves to e.g. 4070 when WINTER_PORT_BASE=4060
depends_on = ["workspace/db"]   # cross-provider: waits on a docker-owned workspace singleton named "db"
                                 # (a service another bound provider declares — not this file's own
                                 # workspace singletons below, which happen to be named "docker"/"registry")

[service.env]
PORT = "${BACKEND_PORT}"
LOG_LEVEL = "debug"

[service.health]
type = "url"
target = "http://localhost:${PORT}/health"
timeout = 5

[service.startup]
retries = 3      # re-launch up to 3 times if the process dies on boot
retry_delay = 2  # seconds between attempts

[[service]]
# cwd is preferred over "cd apps/frontend && npm run dev" — the orchestrator
# resolves it against the scope root before launching the command.
name = "frontend"
target = "0.1"
cwd = "apps/frontend"
cmd = "npm run dev"
port = "WINTER_PORT_BASE + 11"  # resolves to e.g. 4071 when WINTER_PORT_BASE=4060
depends_on = ["backend"]        # same-env: waits for backend's health probe (or liveness) before launching

[service.health]
type = "cmd"
target = "pgrep -f 'npm run dev'"

[[service]]
# Interactive pane — command is empty; the pane gets the env sourced and a
# banner, then sits at a shell prompt. Mirrors `winter_service_cmd shell ""`
# in the bash config.  Set log = "pane" to read this pane via capture-pane
# (no file persistence, no timestamps, requires a running session).
name = "shell"
target = "1.0"
cmd = ""
log = "pane"

[[service]]
# Example of opting a commanded service to pane-mode capture.  The pane still
# runs the command; output is read live via capture-pane rather than a log file.
name = "watcher"
target = "1.1"
cmd = "npm run watch"
log = "pane"

# ---------------------------------------------------------------------------
# Workspace-scoped singleton services
# ---------------------------------------------------------------------------
#
# A [[service]] entry with scope = "workspace" runs in a SEPARATE tmux session
# named <session_prefix>-workspace (e.g. "mp-workspace"), created at the
# workspace root rather than a per-env worktree.  These are shared across all
# feature environments and are intended for long-running infrastructure that
# should not be duplicated per-env (e.g. a shared Docker daemon, a registry, a
# global build watcher).
#
# scope is the only field that distinguishes a workspace singleton from a
# per-env service:
#   scope = "project"   (DEFAULT, may be omitted) — per-env service, runs in
#                       the <session_prefix>-<env> session.
#   scope = "workspace" — workspace singleton, runs in <session_prefix>-workspace.
# All other fields (name/target/command/log) are identical to a project service.
#
# Name uniqueness is GLOBAL across both scopes — a project and a workspace
# service may not share a name.  Target uniqueness is per-scope: a workspace
# service at "0.0" and a project service at "0.0" do NOT conflict (different
# sessions / validated in their own namespace).
#
# Note: for workspace services that manage container lifetimes (e.g.
# `docker compose up`), down reaps the pane process tree, which terminates
# inline-launched containers (best-effort — containers started detached are
# not affected).
#
# workspace_layout_hook: optional bash script invoked once after the workspace
# session is created — same semantics as layout_hook but runs at the workspace
# root.  Value is a BARE FILENAME — resolved relative to this config dir
# (alongside config.toml). It creates the workspace windows/panes; the
# orchestrator sends each service's command into its pane.

workspace_layout_hook = "workspace-layout-hook.sh"

[[service]]
name = "docker"
target = "0.0"
cmd = "docker compose -f docker-compose.workspace.yml up"
scope = "workspace"

[[service]]
# Workspace pane-mode service — reads output via tmux capture-pane rather
# than a persisted log file.  Useful when the command has interactive output
# or TTY colouring that you want preserved.
name = "registry"
target = "0.1"
cmd = "docker run -p 5000:5000 registry:2"
log = "pane"
scope = "workspace"
