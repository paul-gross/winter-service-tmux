# Machine-specific overrides for winter-service-tmux (TOML format). OPTIONAL.
# Copy this to workspace:/.winter/config/winter-service-tmux/config.local.toml
# and customize, then keep it gitignored — it's a per-developer / per-machine
# override that should never be committed.
#
# This file is merged ON TOP of the committed config.toml (overlay), so you
# only redeclare what you want to change. Everything you don't touch keeps the
# committed value. The reader always processes the committed file first, then
# this overlay.
#
# Overlay merge semantics:
#   Scalars (session_prefix, env_file, layout_hook, workspace_layout_hook):
#     The overlay value REPLACES the committed value when present.
#
#   [[service]] — keyed by "name" (any scope):
#     A service whose "name" matches a committed service OVERRIDES it (the
#     overlay fields are merged into the committed entry; unspecified fields
#     keep their committed values). A service with a new "name" is APPENDED
#     after all committed services. The per-entry "scope" ("project" default,
#     or "workspace") travels inside the entry: an override omitting "scope"
#     keeps the committed scope, and a new entry sets its own.
#     The nested [service.env] table is merged by key: local keys replace
#     matching committed keys without moving them, omitted committed keys are
#     preserved, and local-only keys append in local declaration order.
#     Nested [service.health] tables are atomic: if you override health locally,
#     restate the whole health table (type, target, and optional timeout).
#     Nested [service.startup] tables are atomic in the same way: if you
#     override startup locally, restate the whole startup table (retries and
#     optional retry_delay).
#
# Override the session-name prefix locally — DEPRECATED, not part of normal
# setup; the prefix is controlled entirely by winter's workspace-level
# WINTER_SERVICE_PREFIX. Only uncomment this as a manual escape hatch for the
# rare case it collides with another project's tmux sessions on this
# particular machine.
# session_prefix = "myprefix"

# Override a single [logs] key — the reader merges [logs] per-key, so only
# the keys you set here replace the committed values; the rest keep their
# committed defaults.  Example: store larger log files locally.
[logs]
rotate_size_bytes = 52428800  # 50 MiB (committed default is 10 MiB)

# Override a committed service by name — change only what differs locally.
# The orchestrator will use "npm run start:debug" as the command for this pane
# instead of the committed "npm run start:dev", keeping name and target.
# log can also be overridden per-service: "file" (default), "pane", or "memory".
# [service.health] is atomic in overlays, so changing only timeout still requires
# restating type and target under the matching [[service]].
# [service.startup] is atomic in overlays too: overriding startup requires
# restating the whole startup table under the matching [[service]].
# [service.env] is different: it is a per-key merge, so this local PORT value
# replaces the committed PORT mapping while committed LOG_LEVEL remains.
[[service]]
name = "backend"
cmd = "npm run start:debug"
log = "pane"

[service.env]
PORT = "${LOCAL_BACKEND_PORT}"

[service.health]
type = "url"
target = "http://localhost:${PORT}/health"
timeout = 1

# Override the startup retry policy for a committed service — e.g. disable
# retries locally when debugging a crash-on-boot (retries = 0 opts out).
[[service]]
name = "frontend"

[service.startup]
retries = 0  # disable retries locally; committed value had retries = 3

# Append a personal service that isn't in the committed manifest.
# The layout hook (or setup_tmux for now) must also be updated locally to
# create this pane — otherwise the orchestrator will have nowhere to send it.
[[service]]
name = "debugger"
target = "2.0"
cmd = "node --inspect src/index.js"

# Override a committed workspace service by name — e.g. point docker at a
# different compose file locally.  Only the fields you specify are replaced;
# unspecified fields keep their committed values (including scope = "workspace").
[[service]]
name = "docker"
cmd = "docker compose -f docker-compose.local.yml up"

# Append a workspace service that isn't in the committed manifest — e.g. a
# personal monitoring tool.  Set scope = "workspace" so it routes to the
# workspace session.  The workspace_layout_hook must create this pane locally
# or the orchestrator will have nowhere to send it.
[[service]]
name = "local-monitor"
target = "1.0"
cmd = "python -m monitor"
scope = "workspace"
