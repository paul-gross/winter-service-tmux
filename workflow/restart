#!/bin/sh
# Env-root symlink shim — delegates to the Python env_cli door.
# This script is symlinked into feature env dirs (e.g. alpha/restart).
# The symlink's parent directory is the worktree; used to derive env + workspace.

if [ -n "${WINTER_EXT_DIR:-}" ]; then
    _SRC="$WINTER_EXT_DIR/src"
else
    _SELF="$0"
    while [ -L "$_SELF" ]; do
        _SELF="$(readlink "$_SELF")"
    done
    _SRC="$(cd "$(dirname "$_SELF")/.." && pwd)/src"
fi

# Resolve the symlink's absolute path (the env-dir entry, not the real script).
# Passed as argv[0] so env_cli._resolve_from_argv0 can infer env name + workspace.
_SHIM_ABS="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

export PYTHONPATH="$_SRC${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c "
import sys, runpy
sys.argv[0] = sys.argv.pop(1)
runpy.run_module('service_orchestrator.env_cli', run_name='__main__', alter_sys=False)
" "$_SHIM_ABS" restart "$@"
