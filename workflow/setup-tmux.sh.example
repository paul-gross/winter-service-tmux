#!/usr/bin/env bash
# Project tmux configuration for winter workspace scripts.
# Copy this to workspace:/ai/project/setup-tmux.sh and customize.
#
# For machine-specific overrides that shouldn't be committed, add a sibling
# setup-tmux.local.sh — the up/down/status/restart scripts source it on top of
# this file (overlay), so it can override SESSION_PREFIX/ENV_FILE, redefine
# setup_tmux/status_header, extend WINTER_TMUX_SERVICE_NAMES, or add/override a
# service's command with another `winter_service_cmd` call. Keep it gitignored.
# The legacy names workflow.sh / workflow.local.sh still work.

# Session prefix — tmux sessions will be named <prefix>-<worktree>
# e.g., "mp" produces "mp-alpha", "mp-beta"
SESSION_PREFIX="mp"

# Environment file to source (relative to worktree root, optional)
ENV_FILE=".winter.env"

# Service names — used by the status script to label each declared service, by
# ./restart to resolve a service to its pane, and as the source the agent-facing
# setup-tmux.md is generated from. Entries can be either:
#   "<name>"                  — defaults to window 0; pane index = array position.
#                               Use this for simple single-window layouts.
#   "<window>.<pane>:<name>"  — explicit target. Required when services live in
#                               additional tmux windows.
#
# This array is the authoritative service→pane encoding: render-setup-md.sh trusts
# it verbatim, so setup_tmux below MUST place each pane where the array says. With
# bare entries that means panes created in array order within window 0; if your
# layout deviates from that (panes in a different order, or any service outside
# window 0), use the explicit "<window>.<pane>:<name>" form for every entry so the
# generated map can't lie.
WINTER_TMUX_SERVICE_NAMES=("0.0:backend" "0.1:frontend" "1.0:shell")

# Per-service start commands — one `winter_service_cmd <name> <command>` per
# service, keyed by the names declared above. This is the single source of truth
# for *what* each service runs: setup_tmux launches them on `./up`, and
# `./restart <service>` re-runs the same command in place. Declare one for every
# name in WINTER_TMUX_SERVICE_NAMES. `winter_service_cmd` is provided by
# winter-service-tmux.sh.
#
#   - A relative `cd` is resolved against the worktree root on every launch, so a
#     service in a subdirectory is just
#     `winter_service_cmd backend "cd <subdir> && <cmd>"` (the helper resets the
#     pane's cwd first — see winter-service-tmux:/workflow/winter-service-tmux.sh).
#   - Leave a command empty for an interactive pane (e.g. the `shell` below): the
#     pane gets the env sourced and a banner, then sits at a prompt.
winter_service_cmd backend  "npm run start:dev"
winter_service_cmd frontend "npm run dev"
winter_service_cmd shell    ""

# setup_tmux — called by the up script to create tmux windows/panes and start services.
# Arguments: $1=SESSION, $2=WORKTREE_DIR, $3=NAME
#
# This function owns the *layout* (which windows/panes exist and how they split);
# the per-service command comes from the `winter_service_cmd` declarations above.
# Launch each service with `winter_tmux_send_service <session> <pane> <name>` — the helper
# (provided by winter-service-tmux.sh) looks the command up, resets the pane to
# the worktree root, sources the env file when set, prints a banner, and sends it.
# Using the helper here means ./up and ./restart launch services identically.
#
# Renamed from `setup_panes` when multi-window support landed; the up script errors
# out clearly if only the legacy name is defined.
setup_tmux() {
  local session="$1" dir="$2" name="$3"

  # --- Window 0: application services (backend + frontend) ---

  # Pane 0.0: Backend
  winter_tmux_send_service "$session" "0.0" "backend"

  # Split window 0 vertically (top/bottom)
  tmux split-window -v -t "$session:0.0" -c "$dir"

  # Pane 0.1: Frontend
  winter_tmux_send_service "$session" "0.1" "frontend"

  # --- Window 1: utility shell ---

  # Create window 1 (single pane, 1.0)
  tmux new-window -t "$session" -c "$dir"
  winter_tmux_send_service "$session" "1.0" "shell"

  # Land focus on window 0, backend pane
  tmux select-window -t "$session:0"
  tmux select-pane -t "$session:0.0"
}

# status_header — optional, called by the status script before pane status.
# Use it to display ports, URLs, or other project-specific info.
# Arguments: $1=NAME, $2=WORKTREE_DIR
status_header() {
  local name="$1" dir="$2"
  # Example: read ports from env file
  # if [[ -f "$dir/.env" ]]; then
  #   PORT=$(grep -oP 'PORT=\K\d+' "$dir/.env" 2>/dev/null || echo "?")
  #   echo "  http://localhost:$PORT"
  # fi
  :
}
